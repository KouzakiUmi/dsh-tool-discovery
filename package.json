{
  "name": "dsh-tool-discovery",
  "description": "Progressive tool discovery for DSH: three-entry control protocol with a host-independent domain kernel and a DSH adapter (source baseline, not published to npm)",
  "version": "0.2.0-functional.6",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KouzakiUmi/dsh-tool-discovery.git"
  },
  "homepage": "https://github.com/KouzakiUmi/dsh-tool-discovery#readme",
  "bugs": {
    "url": "https://github.com/KouzakiUmi/dsh-tool-discovery/issues"
  },
  "main": "./plugin/adapters/dsh/index.mjs",
  "exports": {
    ".": "./plugin/adapters/dsh/index.mjs",
    "./domain": "./plugin/domain/index.mjs",
    "./client": "./plugin/client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "id": "dsh-tool-discovery",
      "platform": "web",
      "external": [
        "react"
      ]
    }
  },
  "files": [
    "plugin/adapters/",
    "plugin/domain/",
    "plugin/client/",
    "cordis.patch.yml"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": false
    },
    "@deepseek-ai/dsh-tools": {
      "optional": false
    },
    "@deepseek-ai/schemastery": {
      "optional": false
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test plugin/tests/unit/*.test.mjs",
    "test:composition": "node --test plugin/tests/composition/gate-adapter.test.mjs plugin/tests/composition/gate-adapter-lifecycle.test.mjs plugin/tests/composition/gate-adapter-recovery.test.mjs plugin/tests/composition/gate-adapter-event-seq.test.mjs plugin/tests/composition/gate-cache-epoch.test.mjs plugin/tests/composition/gate-settings.test.mjs plugin/tests/composition/gate-review-boundaries.test.mjs plugin/tests/composition/gate-trusted-epoch.test.mjs plugin/tests/composition/gate-trusted-epoch-io.test.mjs plugin/tests/composition/gate-trusted-epoch-fork.test.mjs plugin/tests/composition/gate-trusted-epoch-failclosed.test.mjs plugin/tests/composition/gate-trusted-epoch-badrecord.test.mjs plugin/tests/composition/gate-trusted-epoch-settlement.test.mjs plugin/tests/composition/gate-tool-churn.test.mjs",
    "check:quality": "node plugin/quality/validate.mjs"
  }
}
