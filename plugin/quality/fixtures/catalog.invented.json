        "limitations": {
          "zh": ["不按名称搜索文件。", "大文件需要分段读取。"],
          "en": ["Does not search for files by name.", "Large files must be read in segments."]
        }
      },
      "parametersSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "offset": { "type": "integer" },
          "limit": { "type": "integer" }
        },
        "required": ["path"],
        "additionalProperties": false
      }
    },
    {
      "name": "edit",
      "toolId": "synth_files_edit",
      "synthetic": true,
