      },
      "parametersSchema": {
        "type": "object",
        "properties": {
          "path": { "type": "string" },
          "oldString": { "type": "string" },
          "newString": { "type": "string" }
        },
        "required": ["path", "oldString", "newString"],
        "additionalProperties": false
      }
    },
