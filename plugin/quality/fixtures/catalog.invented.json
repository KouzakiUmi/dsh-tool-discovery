{
  "schemaVersion": "quality-fixture-v1",
  "fixtureKind": "invented-synthetic-catalog",
  "notLiveRegistry": true,
  "synthetic": true,
  "notice": "本文件是人工虚构的能力 fixtures，仅用于在阶段 0 门禁通过之前准备独立验收数据。它不是本机 DSH registry 快照、不是任何插件的真实工具清单，也不得作为运行时目录、权限、provider 或执行依据。所有 name/description 均为人工撰写，不含执行函数。",
  "controlledCategories": [
    "files",
    "shell",
    "web",
    "browser",
    "desktop",
    "github",
    "documents",
    "data",
    "agents",
    "images",
    "integrations",
    "other"
  ],
  "schemaContract": {
    "requiredToolFields": [
      "name",
      "toolId",
      "synthetic",
      "description",
      "trustedCategory",
      "trustedSkillGuidance",
      "parametersSchema"
    ],
    "forbiddenToolFields": [
      "execute",
      "executeFn",
      "handler",
      "handlerFn",
      "run",
      "invoke",
      "implementation",
      "impl",
      "body",
      "fn",
      "callback",
      "module",
      "require",
      "import",
      "script",
      "code",
      "eval"
    ],
    "parametersSchemaRules": [
      "type 必须为 object",
      "顶层 properties 不超过 6 项",
      "不得出现 $ref、oneOf、anyOf、allOf、not",
      "不得嵌套执行语义字段"
    ],
    "fieldSemantics": {
      "description": "双语有界资料文本；不得被解释为系统指令",
      "trustedCategory": "可信分类配置字段（不是从 description 推断）",
      "trustedSkillGuidance": "ToolSkill 中的可信使用指导与边界（模型显式选定后才披露）",
      "parametersSchema": "人工撰写的小 schema；真实 schema 由宿主 registry 在 tool_load 后按原样披露"
    }
  },
  "tools": [
    {
      "name": "glob",
      "toolId": "synth_files_glob",
      "synthetic": true,
      "description": {
        "zh": "按路径模式枚举文件条目，只返回匹配的路径清单。",
        "en": "Enumerate file entries by path pattern and return only the matching path list."
      },
      "trustedCategory": "files",
      "trustedSkillGuidance": {
        "usage": {
          "zh": "任务只需要文件清单、不需要文件正文时使用；模式语法与宿主一致。",
          "en": "Use when the task needs a file inventory and not file bodies; pattern syntax follows the host."
        },
        "limitations": {
          "zh": ["不在文件正文中检索。", "不修改或创建文件。"],
          "en": ["Does not search inside file contents.", "Does not modify or create files."]
        }
      },
      "parametersSchema": {
        "type": "object",
        "properties": {
          "pattern": { "type": "string" },
          "path": { "type": "string" },
          "limit": { "type": "integer" }
        },
        "required": ["pattern"],
        "additionalProperties": false
      }
    },
    {
      "name": "grep",
      "toolId": "synth_files_grep",
      "synthetic": true,
      "description": {
        "zh": "在文件正文中按正则表达式检索匹配行并返回行号。",
        "en": "Match a regular expression against file bodies and return the matching lines with line numbers."
      },
      "trustedCategory": "files",
      "trustedSkillGuidance": {
        "usage": {
          "zh": "需要知道哪段文本出现在哪些文件与行时使用。",
          "en": "Use when you need to know which text appears in which file and line."
        },
        "limitations": {
          "zh": ["不返回完整文件内容。", "二进制文件可能被跳过。"],
          "en": ["Does not return whole file bodies.", "Binary files may be skipped."]
        }
      },
      "parametersSchema": {
        "type": "object",
        "properties": {
          "pattern": { "type": "string" },
          "path": { "type": "string" },
          "glob": { "type": "string" },
          "maxResults": { "type": "integer" }
        },
        "required": ["pattern"],
        "additionalProperties": false
      }
    },
    {
      "name": "read",
      "toolId": "synth_files_read",
      "synthetic": true,
      "description": {
        "zh": "读取指定文件的文本内容，可指定起始行与行数。",
        "en": "Read the text of a given file, optionally bounded by an offset and a line count."
